# Benchmark suite for uuid
import "std/bench"
import "../src/lib.alya" as uuid

function main()
    let runner = bench_runner("uuid Micro-Benchmarks")

    # 1. UUID v4 Generation
    bench_start(runner, 100000)
    let i = 0
    while i < 100000
        uuid::v4()
        i += 1
    end
    bench_stop(runner, "uuid::v4() 100k calls")

    # 2. UUID v7 Generation
    bench_start(runner, 100000)
    let j = 0
    while j < 100000
        uuid::v7()
        j += 1
    end
    bench_stop(runner, "uuid::v7() 100k calls")

    # 3. UUID Validation
    let sample_u4 = uuid::v4()
    bench_start(runner, 200000)
    let k = 0
    while k < 200000
        uuid::is_valid(sample_u4)
        k += 1
    end
    bench_stop(runner, "uuid::is_valid() 200k calls")

    # 4. UUID v7 Timestamp Extraction
    let sample_u7 = uuid::v7()
    bench_start(runner, 200000)
    let m = 0
    while m < 200000
        uuid::get_timestamp(sample_u7)
        m += 1
    end
    bench_stop(runner, "uuid::get_timestamp() 200k calls")

    # 5. Bytes Conversion (to_bytes + from_bytes)
    bench_start(runner, 50000)
    let n = 0
    while n < 50000
        let b = uuid::to_bytes(sample_u4)
        uuid::from_bytes(b)
        n += 1
    end
    bench_stop(runner, "to_bytes + from_bytes 50k calls")

    # 6. ULID Generation
    bench_start(runner, 100000)
    let u = 0
    while u < 100000
        uuid::ulid()
        u += 1
    end
    bench_stop(runner, "uuid::ulid() 100k calls")

    # 7. NanoID Generation
    bench_start(runner, 100000)
    let nid = 0
    while nid < 100000
        uuid::nanoid(21)
        nid += 1
    end
    bench_stop(runner, "uuid::nanoid(21) 100k calls")

    bench_summary(runner)
end

main()
