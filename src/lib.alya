## # uuid
##
## Public API facade for the uuid package.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
##
## Exposes RFC 4122 UUID v4, RFC 9562 UUID v7, ULID, and NanoID generation
## alongside validation, inspection, conversion, and struct ergonomics.

import "./types.alya"
import "./core/v4.alya"
import "./core/v7.alya"
import "./core/ulid.alya"
import "./core/nanoid.alya"
import "./core/parse.alya"

# ───────────────────────────────────────────────────────────────
# Constants
# ───────────────────────────────────────────────────────────────

## Returns the Nil UUID (`00000000-...-000000000000`).
##
## ### Returns
## The Nil UUID string.
pub function nil_uuid() -> string
    return "00000000-0000-0000-0000-000000000000"
end

## Returns the Max UUID (`ffffffff-...-ffffffffffff`).
##
## ### Returns
## The Max UUID string.
pub function max_uuid() -> string
    return "ffffffff-ffff-ffff-ffff-ffffffffffff"
end

# ═══════════════════════════════════════════════════════════════
# 1. UUID Generation (RFC 4122 v4 & RFC 9562 v7)
# ═══════════════════════════════════════════════════════════════

## Generates a standard 36-character RFC 4122 UUID v4.
##
## ### Returns
## The generated UUID v4 string.
##
## ### Examples
## ```alya
## let id = v4()
## ```
pub function v4() -> string
    return core_v4()
end

## Generates a 32-character hex UUID v4 without hyphens.
##
## ### Returns
## The generated simple UUID v4 string.
pub function v4_simple() -> string
    return core_v4_simple()
end

## Generates a standard 36-character RFC 9562 UUID v7 using current time.
##
## ### Returns
## The generated UUID v7 string.
pub function v7() -> string
    return core_v7()
end

## Generates a standard 36-character RFC 9562 UUID v7 for a timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated UUID v7 string.
pub function v7_at(timestamp_ms: int) -> string
    return core_v7_at(timestamp_ms)
end

## Generates a 32-character hex UUID v7 without hyphens using current time.
##
## ### Returns
## The generated simple UUID v7 string.
pub function v7_simple() -> string
    return core_v7_simple()
end

## Generates a 32-character hex UUID v7 without hyphens for a timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated simple UUID v7 string.
pub function v7_simple_at(timestamp_ms: int) -> string
    return core_v7_simple_at(timestamp_ms)
end

# ═══════════════════════════════════════════════════════════════
# 2. ULID & NanoID Generation
# ═══════════════════════════════════════════════════════════════

## Generates a 26-character Crockford Base32 ULID using current time.
##
## ### Returns
## The generated ULID string.
pub function ulid() -> string
    return core_ulid()
end

## Generates a 26-character Crockford Base32 ULID for a timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated ULID string.
pub function ulid_at(timestamp_ms: int) -> string
    return core_ulid_at(timestamp_ms)
end

## Decodes the 48-bit millisecond timestamp from a ULID string.
##
## ### Parameters
## - `ulid_str`: ULID string to decode.
##
## ### Returns
## The millisecond timestamp integer (`0` when malformed).
pub function ulid_timestamp(ulid_str: string) -> int
    return core_ulid_timestamp(ulid_str)
end

## Validates whether a string is a valid 26-character ULID.
##
## ### Parameters
## - `ulid_str`: Candidate string.
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function ulid_is_valid(ulid_str: string) -> int
    return core_ulid_is_valid(ulid_str)
end

## Generates a URL-friendly NanoID of the given size.
##
## ### Parameters
## - `size`: Identifier length. Defaults to `21`.
## - `alphabet`: Sampling alphabet string. Defaults to URL-friendly symbols.
##
## ### Returns
## The generated NanoID string.
pub function nanoid(size: int = 21, alphabet: string = "_-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ") -> string
    return core_nanoid(size, alphabet)
end

# ═══════════════════════════════════════════════════════════════
# 3. Validation, Inspection & Parsing
# ═══════════════════════════════════════════════════════════════

## Returns `1` when a string is a valid 36-char or 32-char UUID.
##
## ### Parameters
## - `s`: Candidate string.
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function is_valid(s: string) -> int
    return core_is_valid(s)
end

## Returns `1` when a UUID is the Nil UUID.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## `1` when nil, `0` otherwise.
pub function is_nil(s: string) -> int
    return core_is_nil(s)
end

## Returns `1` when a UUID is the Max UUID.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## `1` when max, `0` otherwise.
pub function is_max(s: string) -> int
    return core_is_max(s)
end

## Extracts the UUID version as an integer (`0` when invalid).
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Version number (e.g. `4` or `7`), or `0` when invalid.
pub function version(s: string) -> int
    return core_version(s)
end

## Extracts the Unix millisecond timestamp from a UUID v7 string.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Millisecond timestamp integer (`0` when not a valid v7).
pub function get_timestamp(s: string) -> int
    return core_timestamp(s)
end

## Alias for `get_timestamp`.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Millisecond timestamp integer (`0` when not a valid v7).
pub function extract_timestamp(s: string) -> int
    return core_timestamp(s)
end

## Converts a UUID string into an array of 16 byte integers (`0..255`).
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Byte array (empty when invalid).
pub function to_bytes(s: string) -> array
    return core_to_bytes(s)
end

## Constructs a standard 36-character UUID string from 16 byte integers.
##
## ### Parameters
## - `bytes`: Array of 16 byte integers.
##
## ### Returns
## Standard UUID string (Nil UUID when fewer than 16 bytes).
pub function from_bytes(bytes: array) -> string
    return core_from_bytes(bytes)
end

## Converts a 36-character UUID to a 32-character simple hex string.
##
## ### Parameters
## - `s`: Standard UUID string.
##
## ### Returns
## Hyphen-free hex string.
pub function to_simple(s: string) -> string
    return core_to_simple(s)
end

## Converts a 32-character simple hex string to a standard UUID.
##
## ### Parameters
## - `simple_hex`: 32-character hex string.
##
## ### Returns
## Standard UUID string (input unchanged when not 32 chars).
pub function to_standard(simple_hex: string) -> string
    return core_to_standard(simple_hex)
end

## Formats a UUID as an RFC 4122 URN (`urn:uuid:...`).
##
## ### Parameters
## - `s`: Standard (36-char) or simple (32-char) UUID string.
##
## ### Returns
## The URN string.
pub function to_urn(s: string) -> string
    return core_to_urn(s)
end

## Parses a UUID string into a `Uuid` struct.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## The parsed `Uuid` instance (`is_valid` is `0` when malformed).
pub function parse(s: string) -> Uuid
    return core_parse_uuid(s)
end

# ═══════════════════════════════════════════════════════════════
# 4. Idiomatic Struct Methods on Uuid
# ═══════════════════════════════════════════════════════════════

## Returns the raw UUID string.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## The raw UUID string.
pub function Uuid.to_string(self: Uuid) -> string
    return self.raw
end

## Returns the hyphen-free hex form of this UUID.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## Hyphen-free hex string.
pub function Uuid.to_simple(self: Uuid) -> string
    return core_to_simple(self.raw)
end

## Returns the RFC 4122 URN form of this UUID.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## The URN string.
pub function Uuid.to_urn(self: Uuid) -> string
    return core_to_urn(self.raw)
end

## Returns `1` when this UUID is the Nil UUID.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## `1` when nil, `0` otherwise.
pub function Uuid.is_nil(self: Uuid) -> int
    return core_is_nil(self.raw)
end

## Returns `1` when this UUID is the Max UUID.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## `1` when max, `0` otherwise.
pub function Uuid.is_max(self: Uuid) -> int
    return core_is_max(self.raw)
end

## Extracts the Unix millisecond timestamp from this UUID v7.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## Millisecond timestamp integer (`0` when not a valid v7).
pub function Uuid.get_timestamp(self: Uuid) -> int
    return core_timestamp(self.raw)
end

## Returns the 16-byte array of this UUID.
##
## ### Parameters
## - `self`: The target `Uuid` instance.
##
## ### Returns
## Byte array (empty when invalid).
pub function Uuid.to_bytes(self: Uuid) -> array
    return self.bytes
end
