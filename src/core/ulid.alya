## # uuid/core/ulid
##
## Crockford Base32 Universally Unique Lexicographically Sortable Identifier.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "rand" as rand

# Internal Crockford Base32 character decoder (private to module).
function _crockford_val(ch: string) -> int
    let c = ord(ch)
    return when c
        is 48..57   => c - 48
        is 65..72   => c - 55
        is 74..75   => c - 56
        is 77..78   => c - 57
        is 80..84   => c - 58
        is 86..90   => c - 59
        is 97..104  => c - 87
        is 106..107 => c - 88
        is 109..110 => c - 89
        is 112..116 => c - 90
        is 118..122 => c - 91
        else        => -1
    end
end

## Generates a 26-character ULID for a given millisecond timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated ULID string.
pub function core_ulid_at(timestamp_ms: int) -> string
    let crockford = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
    let time_rev = []
    let temp = timestamp_ms
    let i = 0
    while i < 10
        let idx = bit_and(temp, 31)
        time_rev.push(char_at(crockford, idx))
        temp = bit_shr(temp, 5)
        i += 1
    end
    let res = ""
    let j = 9
    while j >= 0
        res += time_rev[j]
        j -= 1
    end
    let rand_chars = rand::string(16, crockford)
    return res + rand_chars
end

## Generates a 26-character ULID using current system time.
##
## ### Returns
## The generated ULID string.
pub function core_ulid() -> string
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return core_ulid_at(now_ms)
end

## Decodes the 48-bit millisecond timestamp from a ULID string.
##
## ### Parameters
## - `ulid_str`: ULID string to decode.
##
## ### Returns
## The millisecond timestamp integer (`0` when malformed).
pub function core_ulid_timestamp(ulid_str: string) -> int
    if len(ulid_str) < 10
        return 0
    end
    let ts = 0
    let i = 0
    while i < 10
        let ch = char_at(ulid_str, i)
        let v = _crockford_val(ch)
        if v < 0
            return 0
        end
        ts = bit_or(bit_shl(ts, 5), v)
        i += 1
    end
    return ts
end

## Validates whether a string is a valid 26-character Crockford Base32 ULID.
##
## ### Parameters
## - `s`: Candidate string.
##
## ### Returns
## `1` when valid, `0` otherwise.
pub function core_ulid_is_valid(s: string) -> int
    if len(s) != 26
        return 0
    end
    let i = 0
    while i < 26
        let ch = char_at(s, i)
        if _crockford_val(ch) < 0
            return 0
        end
        i += 1
    end
    return 1
end
