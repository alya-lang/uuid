## # uuid/core/parse
##
## Validation, parsing, and inspection utilities for UUIDs.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "../types.alya"

# Internal hex character check (private to module).
function _is_hex_char(ch: string) -> int
    let c = ord(ch)
    return when
        (c >= 48 and c <= 57) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70) => 1
        else => 0
    end
end

# Internal hex digit to integer converter (private to module).
function _hex_to_int(ch: string) -> int
    let c = ord(ch)
    return when c
        is 48..57  => c - 48
        is 97..102 => c - 87
        is 65..70  => c - 55
        else       => 0
    end
end

## Validates whether a string is a UUID (standard 36-char or simple 32-char).
##
## ### Parameters
## - `s`: Candidate string.
##
## ### Returns
## `1` when valid, `0` otherwise.
##
## ### Examples
## ```alya
## say core_is_valid("00000000-0000-0000-0000-000000000000") # 1
## ```
pub function core_is_valid(s: string) -> int
    let slen = len(s)
    if slen == 36
        if char_at(s, 8) != "-" or char_at(s, 13) != "-" or char_at(s, 18) != "-" or char_at(s, 23) != "-"
            return 0
        end
        let i = 0
        while i < 36
            if i != 8 and i != 13 and i != 18 and i != 23
                if _is_hex_char(char_at(s, i)) == 0
                    return 0
                end
            end
            i += 1
        end
        return 1
    end
    if slen == 32
        let i = 0
        while i < 32
            if _is_hex_char(char_at(s, i)) == 0
                return 0
            end
            i += 1
        end
        return 1
    end
    return 0
end

## Checks whether a UUID is the Nil UUID (all zeroes).
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## `1` when nil, `0` otherwise.
pub function core_is_nil(s: string) -> int
    if s == "00000000-0000-0000-0000-000000000000" or s == "00000000000000000000000000000000"
        return 1
    end
    return 0
end

## Checks whether a UUID is the Max UUID (all `f` digits).
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## `1` when max, `0` otherwise.
pub function core_is_max(s: string) -> int
    if s == "ffffffff-ffff-ffff-ffff-ffffffffffff" or s == "FFFFFFFF-FFFF-FFFF-FFFF-FFFFFFFFFFFF" or s == "ffffffffffffffffffffffffffffffff" or s == "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF"
        return 1
    end
    return 0
end

## Extracts the UUID version as an integer, or `0` when invalid.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Version number (e.g. `4` or `7`), or `0` when invalid.
pub function core_version(s: string) -> int
    if core_is_valid(s) == 0
        return UuidVersion.Unknown
    end
    let slen = len(s)
    let v_char = ""
    if slen == 36
        v_char = char_at(s, 14)
    else
        v_char = char_at(s, 12)
    end
    let v_num = _hex_to_int(v_char)
    return when v_num
        is 4 => UuidVersion.V4
        is 7 => UuidVersion.V7
        is 1 => UuidVersion.V1
        is 2 => UuidVersion.V2
        is 3 => UuidVersion.V3
        is 5 => UuidVersion.V5
        is 6 => UuidVersion.V6
        is 8 => UuidVersion.V8
        else => v_num
    end
end

## Extracts the Unix millisecond timestamp from a UUID v7 string.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Millisecond timestamp integer (`0` when not a valid v7).
pub function core_timestamp(s: string) -> int
    if core_is_valid(s) == 0
        return 0
    end
    let v = core_version(s)
    if v != 7
        return 0
    end
    let hex_time = ""
    let slen = len(s)
    if slen == 36
        let i = 0
        while i < 8
            hex_time += char_at(s, i)
            i += 1
        end
        i = 9
        while i < 13
            hex_time += char_at(s, i)
            i += 1
        end
    else
        let i = 0
        while i < 12
            hex_time += char_at(s, i)
            i += 1
        end
    end

    let ts = 0
    let k = 0
    while k < 12
        let digit = _hex_to_int(char_at(hex_time, k))
        ts = bit_or(bit_shl(ts, 4), digit)
        k += 1
    end
    return ts
end

## Converts a UUID string into an array of 16 byte integers (`0..255`).
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## Byte array (empty when invalid).
pub function core_to_bytes(s: string) -> array
    if core_is_valid(s) == 0
        return []
    end
    let hex_only = ""
    let slen = len(s)
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch != "-"
            hex_only += ch
        end
        i += 1
    end

    let bytes = []
    let b = 0
    while b < 16
        let hi = _hex_to_int(char_at(hex_only, b * 2))
        let lo = _hex_to_int(char_at(hex_only, (b * 2) + 1))
        bytes.push(bit_or(bit_shl(hi, 4), lo))
        b += 1
    end
    return bytes
end

## Formats a 32-character hex string into a 36-character standard UUID.
##
## ### Parameters
## - `simple_hex`: 32-character hex string.
##
## ### Returns
## Standard UUID string (input returned unchanged when not 32 chars).
pub function core_to_standard(simple_hex: string) -> string
    if len(simple_hex) != 32
        return simple_hex
    end
    let res = ""
    let i = 0
    while i < 32
        if i in [8, 12, 16, 20]
            res += "-"
        end
        res += char_at(simple_hex, i)
        i += 1
    end
    return res
end

## Constructs a standard 36-character UUID string from 16 byte integers.
##
## ### Parameters
## - `bytes`: Array of 16 byte integers.
##
## ### Returns
## Standard UUID string (Nil UUID when fewer than 16 bytes).
pub function core_from_bytes(bytes: array) -> string
    if len(bytes) < 16
        return "00000000-0000-0000-0000-000000000000"
    end
    let hex_chars = "0123456789abcdef"
    let hex_str = ""
    let i = 0
    while i < 16
        let b = bytes[i]
        let hi = bit_and(bit_shr(b, 4), 15)
        let lo = bit_and(b, 15)
        hex_str = hex_str + char_at(hex_chars, hi) + char_at(hex_chars, lo)
        i += 1
    end

    return core_to_standard(hex_str)
end

## Converts a 36-character standard UUID to a 32-character simple hex string.
##
## ### Parameters
## - `s`: Standard UUID string.
##
## ### Returns
## Hyphen-free hex string.
pub function core_to_simple(s: string) -> string
    let res = ""
    let slen = len(s)
    let i = 0
    while i < slen
        let ch = char_at(s, i)
        if ch != "-"
            res += ch
        end
        i += 1
    end
    return res
end

## Formats a UUID as an RFC 4122 URN (`urn:uuid:...`).
##
## ### Parameters
## - `s`: Standard (36-char) or simple (32-char) UUID string.
##
## ### Returns
## The URN string.
##
## ### Examples
## ```alya
## say core_to_urn("00000000-0000-0000-0000-000000000000")
## ```
pub function core_to_urn(s: string) -> string
    let std = s
    if len(s) == 32
        std = core_to_standard(s)
    end
    return "urn:uuid:{std}"
end

## Parses a UUID string into a `Uuid` struct.
##
## ### Parameters
## - `s`: Candidate UUID string.
##
## ### Returns
## The parsed `Uuid` instance (`is_valid` is `0` when malformed).
pub function core_parse_uuid(s: string) -> Uuid
    let valid = core_is_valid(s)
    if valid == 0
        return Uuid {
            raw: s,
            version: UuidVersion.Unknown,
            is_valid: 0,
            bytes: []
        }
    end
    return Uuid {
        raw: s,
        version: core_version(s),
        is_valid: 1,
        bytes: core_to_bytes(s)
    }
end
