# v7.alya - RFC 9562 UUID Version 7 Generator (Time-ordered)
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "rand" as rand

function _v7_hex_digit(ch)
    let c = ord(ch)
    if c >= 48 and c <= 57
        return c - 48
    end
    if c >= 97 and c <= 102
        return c - 87
    end
    if c >= 65 and c <= 70
        return c - 55
    end
    return 0
end

# Converts 48-bit millisecond timestamp to 12 hex characters
function _v7_hex_time(ms)
    let hex_chars = "0123456789abcdef"
    let hex_rev = []
    let temp = ms
    let i = 0
    while i < 12
        let d = bit_and(temp, 15)
        hex_rev.push(char_at(hex_chars, d))
        temp = bit_shr(temp, 4)
        i += 1
    end
    let res = ""
    let j = 11
    while j >= 0
        res = res + hex_rev[j]
        j -= 1
    end
    return res
end

# Generates 36-character standard UUID v7 for a given millisecond timestamp
function core_v7_at(timestamp_ms)
    let hex_chars = "0123456789abcdef"
    let time_hex = _v7_hex_time(timestamp_ms)
    let rand_part = rand::hex(20)
    let res = ""
    let i = 0
    while i < 8
        res = res + char_at(time_hex, i)
        i += 1
    end
    res = res + "-"
    while i < 12
        res = res + char_at(time_hex, i)
        i += 1
    end
    res = res + "-7"
    res = res + char_at(rand_part, 0) + char_at(rand_part, 1) + char_at(rand_part, 2)
    res = res + "-"
    let orig = char_at(rand_part, 3)
    let v = _v7_hex_digit(orig)
    let variant_digit = bit_or(bit_and(v, 3), 8)
    res = res + char_at(hex_chars, variant_digit)
    res = res + char_at(rand_part, 4) + char_at(rand_part, 5) + char_at(rand_part, 6)
    res = res + "-"
    let k = 7
    while k < 19
        res = res + char_at(rand_part, k)
        k += 1
    end
    return res
end

# Generates 36-character standard UUID v7 using current system time
function core_v7()
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return core_v7_at(now_ms)
end

# Generates 32-character hex UUID v7 without hyphens for a given millisecond timestamp
function core_v7_simple_at(timestamp_ms)
    let hex_chars = "0123456789abcdef"
    let time_hex = _v7_hex_time(timestamp_ms)
    let rand_part = rand::hex(20)
    let res = time_hex + "7" + char_at(rand_part, 0) + char_at(rand_part, 1) + char_at(rand_part, 2)
    let orig = char_at(rand_part, 3)
    let v = _v7_hex_digit(orig)
    let variant_digit = bit_or(bit_and(v, 3), 8)
    res = res + char_at(hex_chars, variant_digit)
    let k = 4
    while k < 19
        res = res + char_at(rand_part, k)
        k += 1
    end
    return res
end

# Generates 32-character hex UUID v7 without hyphens using current system time
function core_v7_simple()
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return core_v7_simple_at(now_ms)
end
