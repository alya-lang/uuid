## # uuid/core/v7
##
## RFC 9562 UUID version 7 generator (time-ordered).
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "rand" as rand

# Internal hex digit converter (private to module).
function _v7_hex_digit(ch: string) -> int
    let c = ord(ch)
    return when c
        is 48..57  => c - 48
        is 97..102 => c - 87
        is 65..70  => c - 55
        else       => 0
    end
end

# Converts a 48-bit millisecond timestamp to 12 hex characters (private to module).
function _v7_hex_time(ms: int) -> string
    let hex_chars = "0123456789abcdef"
    let hex_rev = []
    let temp = ms
    let i = 0
    while i < 12
        let d = bit_and(temp, 15)
        hex_rev.push(char_at(hex_chars, d))
        temp = bit_shr(temp, 4)
        i += 1
    end
    let res = ""
    let j = 11
    while j >= 0
        res += hex_rev[j]
        j -= 1
    end
    return res
end

## Generates a 36-character standard UUID v7 for a given millisecond timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated UUID v7 string.
pub function core_v7_at(timestamp_ms: int) -> string
    let hex_chars = "0123456789abcdef"
    let time_hex = _v7_hex_time(timestamp_ms)
    let rand_part = rand::hex(20)
    let res = ""
    let i = 0
    while i < 8
        res += char_at(time_hex, i)
        i += 1
    end
    res += "-"
    while i < 12
        res += char_at(time_hex, i)
        i += 1
    end
    res += "-7"
    res = res + char_at(rand_part, 0) + char_at(rand_part, 1) + char_at(rand_part, 2)
    res += "-"
    let orig = char_at(rand_part, 3)
    let v = _v7_hex_digit(orig)
    let variant_digit = bit_or(bit_and(v, 3), 8)
    res = res + char_at(hex_chars, variant_digit)
    res = res + char_at(rand_part, 4) + char_at(rand_part, 5) + char_at(rand_part, 6)
    res += "-"
    let k = 7
    while k < 19
        res += char_at(rand_part, k)
        k += 1
    end
    return res
end

## Generates a 36-character standard UUID v7 using current system time.
##
## ### Returns
## The generated UUID v7 string.
pub function core_v7() -> string
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return core_v7_at(now_ms)
end

## Generates a 32-character hex UUID v7 without hyphens for a timestamp.
##
## ### Parameters
## - `timestamp_ms`: Unix timestamp in milliseconds.
##
## ### Returns
## The generated simple UUID v7 string.
pub function core_v7_simple_at(timestamp_ms: int) -> string
    let hex_chars = "0123456789abcdef"
    let time_hex = _v7_hex_time(timestamp_ms)
    let rand_part = rand::hex(20)
    let res = time_hex + "7" + char_at(rand_part, 0) + char_at(rand_part, 1) + char_at(rand_part, 2)
    let orig = char_at(rand_part, 3)
    let v = _v7_hex_digit(orig)
    let variant_digit = bit_or(bit_and(v, 3), 8)
    res += char_at(hex_chars, variant_digit)
    let k = 4
    while k < 19
        res += char_at(rand_part, k)
        k += 1
    end
    return res
end

## Generates a 32-character hex UUID v7 without hyphens using current time.
##
## ### Returns
## The generated simple UUID v7 string.
pub function core_v7_simple() -> string
    let now_ms = (time() * 1000) + (clock_ms() % 1000)
    return core_v7_simple_at(now_ms)
end
