## # uuid/core/v4
##
## RFC 4122 UUID version 4 generator.
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).

import "rand" as rand

# Internal hex digit converter (private to module).
function _v4_hex_digit(ch: string) -> int
    let c = ord(ch)
    return when c
        is 48..57  => c - 48
        is 97..102 => c - 87
        is 65..70  => c - 55
        else       => 0
    end
end

## Generates a standard 36-character RFC 4122 UUID v4.
##
## Layout: `xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx` with RFC variant bits.
##
## ### Returns
## The generated UUID v4 string.
##
## ### Examples
## ```alya
## let id = core_v4()
## ```
pub function core_v4() -> string
    let hex_chars = "0123456789abcdef"
    let raw_hex = rand::hex(32)
    let res = ""
    let i = 0
    while i < 32
        if i in [8, 12, 16, 20]
            res += "-"
        end
        if i == 12
            res += "4"
        elif i == 16
            let orig = char_at(raw_hex, i)
            let v = _v4_hex_digit(orig)
            let masked = bit_or(bit_and(v, 3), 8)
            res += char_at(hex_chars, masked)
        else
            res += char_at(raw_hex, i)
        end
        i += 1
    end
    return res
end

## Generates a 32-character hex UUID v4 without hyphens.
##
## ### Returns
## The generated simple UUID v4 string.
pub function core_v4_simple() -> string
    let hex_chars = "0123456789abcdef"
    let raw_hex = rand::hex(32)
    let res = ""
    let i = 0
    while i < 32
        if i == 12
            res += "4"
        elif i == 16
            let orig = char_at(raw_hex, i)
            let v = _v4_hex_digit(orig)
            let masked = bit_or(bit_and(v, 3), 8)
            res += char_at(hex_chars, masked)
        else
            res += char_at(raw_hex, i)
        end
        i += 1
    end
    return res
end
