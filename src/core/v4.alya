# v4.alya - RFC 4122 UUID Version 4 Generator
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "rand" as rand

# Internal hex digit converter (private to module)
function _v4_hex_digit(ch)
    let c = ord(ch)
    if c >= 48 and c <= 57
        return c - 48
    end
    if c >= 97 and c <= 102
        return c - 87
    end
    if c >= 65 and c <= 70
        return c - 55
    end
    return 0
end

# Generates standard 36-char RFC 4122 UUID v4: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
pub function core_v4()
    let hex_chars = "0123456789abcdef"
    let raw_hex = rand::hex(32)
    let res = ""
    let i = 0
    while i < 32
        if i in [8, 12, 16, 20]
            res += "-"
        end
        if i == 12
            res += "4"
        elif i == 16
            let orig = char_at(raw_hex, i)
            let v = _v4_hex_digit(orig)
            let masked = bit_or(bit_and(v, 3), 8)
            res += char_at(hex_chars, masked)
        else
            res += char_at(raw_hex, i)
        end
        i += 1
    end
    return res
end

# Generates 32-character hex UUID v4 without hyphens
pub function core_v4_simple()
    let hex_chars = "0123456789abcdef"
    let raw_hex = rand::hex(32)
    let res = ""
    let i = 0
    while i < 32
        if i == 12
            res += "4"
        elif i == 16
            let orig = char_at(raw_hex, i)
            let v = _v4_hex_digit(orig)
            let masked = bit_or(bit_and(v, 3), 8)
            res += char_at(hex_chars, masked)
        else
            res += char_at(raw_hex, i)
        end
        i += 1
    end
    return res
end
