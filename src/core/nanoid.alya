# nanoid.alya - Compact, URL-friendly unique string identifier generator
# Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "rand" as rand

# Generates URL-safe NanoID of specified size (default 21)
pub function core_nanoid(size = 21, alphabet = "_-0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
    if size <= 0
        return ""
    end
    return rand::string(size, alphabet)
end
